# Render backend secrets — never place these in index.html or Vercel client code
SECRET_KEY=replace-with-at-least-32-random-bytes
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
PAYSTACK_SECRET_KEY=sk_test_or_live_secret
PUBLIC_APP_URL=https://YOUR-KNEXA.vercel.app
FRONTEND_ORIGIN=https://YOUR-KNEXA.vercel.app
ALLOWED_HOSTS=YOUR-RENDER-SERVICE.onrender.com
OWNER_KNEXA_ID=
TRUST_PROXY=true
PROXY_HOPS=1
API_PER_MINUTE=90
AI_PER_MINUTE=10
AI_PER_DAY=150
EXAMS_PER_HOUR=5
FREE_AI_TEXT_DAILY=5
FREE_AI_IMAGE_DAILY=2
FREE_PRACTICE_DAILY=1
FREE_CBT_DAILY=1
PRO_AI_TEXT_DAILY=500
PRO_AI_IMAGE_DAILY=100
PRO_PRACTICE_DAILY=100
PRO_CBT_DAILY=20
